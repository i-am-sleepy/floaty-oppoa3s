<?xml version="1.0" encoding="utf-8"?>
<!-- Round bubble: solid black circle with a faint white outline so it reads
     on both light and dark wallpapers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/bubble_bg" />
    <stroke
        android:width="1.5dp"
        android:color="#55FFFFFF" />
    <size
        android:width="40dp"
        android:height="40dp" />
</shape>
