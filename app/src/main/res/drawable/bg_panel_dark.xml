<?xml version="1.0" encoding="utf-8"?>
<!-- Volume panel card: semitransparent black with rounded corners.
     The alpha is adjusted at runtime (panel transparency slider), so this
     drawable only serves as the initial/fallback background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/panel_card_bg" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/divider_on_dark" />
</shape>
