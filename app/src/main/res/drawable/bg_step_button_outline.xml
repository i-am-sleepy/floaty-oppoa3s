<?xml version="1.0" encoding="utf-8"?>
<!-- +/- step buttons on the dark panel: transparent fill (the panel's black
     background shows through) with a white circular outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/white" />
</shape>
