<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen scrim window shown only while the panel is open.
  Touching the scrim (i.e. outside the card) closes the panel.
  Card is semitransparent black with white text; the card background alpha is
  adjusted at runtime from the app screen (panel transparency slider).
  Framework widgets only: no AndroidX dependency.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/panelCard"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_panel_dark"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- Header: title, red power (terminate) button, close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panel_title"
                android:textColor="@color/text_on_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnPower"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_power"
                android:contentDescription="@string/panel_power"
                android:padding="7dp"
                android:src="@drawable/ic_power" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:contentDescription="@string/panel_close"
                android:text="✕"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Big step buttons for the targeted stream -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/targetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stream_media"
                    android:textColor="@color/text_on_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/targetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 15"
                    android:textColor="@color/text_secondary_on_dark"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="3dp"
            android:background="@color/divider_on_dark" />

        <!-- Media -->
        <LinearLayout
            android:id="@+id/rowMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:text="@string/stream_media"
                android:textColor="@color/text_on_dark"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekMedia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/seekbar_white"
                android:thumb="@drawable/seekbar_thumb_white" />

            <TextView
                android:id="@+id/valMedia"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Ringtone -->
        <LinearLayout
            android:id="@+id/rowRing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:text="@string/stream_ring"
                android:textColor="@color/text_on_dark"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekRing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/seekbar_white"
                android:thumb="@drawable/seekbar_thumb_white" />

            <TextView
                android:id="@+id/valRing"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Alarm -->
        <LinearLayout
            android:id="@+id/rowAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:text="@string/stream_alarm"
                android:textColor="@color/text_on_dark"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekAlarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/seekbar_white"
                android:thumb="@drawable/seekbar_thumb_white" />

            <TextView
                android:id="@+id/valAlarm"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- System -->
        <LinearLayout
            android:id="@+id/rowSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:text="@string/stream_system"
                android:textColor="@color/text_on_dark"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekSystem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/seekbar_white"
                android:thumb="@drawable/seekbar_thumb_white" />

            <TextView
                android:id="@+id/valSystem"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Call (voice call volume during a phone call) -->
        <LinearLayout
            android:id="@+id/rowCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:text="@string/stream_call"
                android:textColor="@color/text_on_dark"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/seekbar_white"
                android:thumb="@drawable/seekbar_thumb_white" />

            <TextView
                android:id="@+id/valCall"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
