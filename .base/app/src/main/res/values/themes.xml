<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Framework Material theme: no AppCompat/AndroidX dependency needed. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SectionBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>
