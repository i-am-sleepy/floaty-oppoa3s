<?xml version="1.0" encoding="utf-8"?>
<!-- Round bubble: solid brand circle with a soft outline so it reads on any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/brand" />
    <stroke
        android:width="2dp"
        android:color="#66FFFFFF" />
    <size
        android:width="56dp"
        android:height="56dp" />
</shape>
